package-as: RGXProfessions

license: LICENSE

enable-nolib-creation: no

ignore:
  - .github
  - .gitignore
  - README.md
  - .pkgmeta
  - .gitlab-ci.yml
  - AGENTS.md
  - docs
  - tests
  - tools
  - Media/README.md
  - Media/RGXLogo.png
  - Media/kiwi.gif
  - Data/Cata
  - Data/Mists
  - wago_description.md

manual-changelog:
  filename: docs/CHANGES.md
  markup-type: markdown
